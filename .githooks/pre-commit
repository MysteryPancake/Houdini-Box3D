#!/usr/bin/env bash
# Rejects a commit whose staged C/C++ files under src/ or tests/ are not clang-formatted.
# Enable once per clone:  git config core.hooksPath .githooks
# Fix:                    cmake --build build --target format   (or clang-format -i <file>)
set -euo pipefail

if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: clang-format not found; skipping the format check." >&2
    exit 0
fi

files=()
while IFS= read -r -d '' f; do
    files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- 'src/*.cpp' 'src/*.h' 'tests/*.cpp' 'tests/*.h')

[ ${#files[@]} -eq 0 ] && exit 0

bad=()
for f in "${files[@]}"; do
    # Check the staged content, not the working copy.
    if ! git show ":$f" | clang-format --style=file --assume-filename="$f" --dry-run -Werror >/dev/null 2>&1; then
        bad+=("$f")
    fi
done

if [ ${#bad[@]} -gt 0 ]; then
    echo "pre-commit: not clang-formatted (run clang-format -i on them and re-stage):" >&2
    printf '  %s\n' "${bad[@]}" >&2
    exit 1
fi
